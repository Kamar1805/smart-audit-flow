rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: a user can read/write only their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Requests collection: basic role-based access example
    match /requests/{requestId} {
      allow read: if request.auth != null; // allow all authenticated reads
      allow create: if request.auth != null; // any signed-in user can create
      // Updates could be restricted by role or ownership; adjust as needed
      allow update, delete: if request.auth != null && (request.resource.data.role in ['requester','procurement','audit','finance']);
    }
  }
}
